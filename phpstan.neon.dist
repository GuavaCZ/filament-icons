includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    ignoreErrors:
        # GeneratorCommand's PHPDoc says bool|null, but Command::execute() casts the
        # return value to an int exit code, and the command uses 1 to signal failure.
        -
            identifier: method.childReturnType
            path: src/Commands/GenerateIconEnumClassCommand.php
